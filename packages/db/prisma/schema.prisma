generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RestaurantStatus {
  ACTIVE
  INACTIVE
}

enum OnboardingStatus {
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

// Billing tier. Managed by admin; no payment/invoicing wired yet — the field
// just records which plan a restaurant is on.

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum TableShape {
  SQUARE
  RECT
  ROUND
}

enum ServingUnit {
  GRAM
  KILOGRAM
  MILLILITER
  LITER
  PIECE // adet
  PORTION // porsiyon (no unit price)
}

// How an item's normalized unit price is shown. AUTO lets @repo/core pick
// visibility + magnitude (per-100g for pricey weights, per-L for sensible
// volumes, hidden for tiny servings); HIDE suppresses it; the rest force a
// specific magnitude. See packages/core/src/unit-price.ts.

enum UnitPriceBasis {
  AUTO
  HIDE
  PER_KG
  PER_100G
  PER_L
  PER_100ML
  PER_PIECE
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum MediaType {
  PHOTO
  VIDEO
}

// Admin activity feed. A simple, durable audit trail — one row per notable
// domain event. Detailed/structured logging is a later concern; `meta` holds
// the human-readable bits (names, old/new values) for now.

enum ActivityType {
  RESTAURANT_CREATED
  RESTAURANT_RENAMED
  SLUG_CHANGED
  STATUS_CHANGED
  PLAN_CHANGED
  ONBOARDING_CHANGED
  CATEGORY_CREATED
  CATEGORY_DELETED
  MENU_ITEM_CREATED
  MENU_ITEM_DELETED
}

// Restaurant team roles. The OWNER ⊇ MANAGER ⊇ STAFF capability ordering and the
// per-action permission catalog live in @repo/schemas (evaluated server-side),
// not as DB columns.

enum RestaurantRole {
  OWNER
  MANAGER
  STAFF
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Restaurant {
  id               String                 @id @default(cuid(2))
  name             String
  slug             String                 @unique
  status           RestaurantStatus       @default(INACTIVE)
  onboardingStatus OnboardingStatus       @default(IN_PROGRESS)
  // Locale preferences. Stored as strings (allowed set lives in @repo/schemas)
  // so adding a language/currency later needs no migration. Only "tr"/"TRY" are
  // offered today; downstream formatting still assumes TRY.
  language         String                 @default("tr")
  currency         String                 @default("TRY")
  plan             Plan                   @default(FREE)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  floors           Floor[]
  categories       Category[]
  menuItems        MenuItem[]
  allergens        Allergen[]
  tags             Tag[]
  activities       Activity[]
  members          RestaurantMember[]
  invitations      RestaurantInvitation[]

  @@map("restaurants")
}

// A user's membership of (and role in) one restaurant — the basis for all
// dashboard authorization. `userId` references the dashboard Better Auth
// instance's user (`dash_user.id`); there is no FK to it (separate audience).
// Service invariant: every restaurant keeps ≥1 OWNER at all times (FR-015).

model RestaurantMember {
  id               String         @id @default(cuid(2))
  restaurantId     String
  restaurant       Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId           String
  role             RestaurantRole
  suspended        Boolean        @default(false)
  directlyAssigned Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([restaurantId, userId])
  @@index([userId])
  @@index([restaurantId])
  @@map("restaurant_members")
}

// A pending/closed invitation to join a restaurant. Covers admin→owner and
// owner→member. The raw single-use token is emailed; only its hash is stored.

model RestaurantInvitation {
  id              String           @id @default(cuid(2))
  restaurantId    String
  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  email           String
  role            RestaurantRole
  status          InvitationStatus @default(PENDING)
  tokenHash       String
  invitedByUserId String?
  invitedByAdmin  Boolean          @default(false)
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([restaurantId])
  @@index([email])
  @@index([tokenHash])
  @@map("restaurant_invitations")
}

model Activity {
  id           String       @id @default(cuid(2))
  // Nullable so future platform-wide events can be recorded too; today every
  // event is restaurant-scoped and deletes with its restaurant.
  restaurantId String?
  restaurant   Restaurant?  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  type         ActivityType
  meta         Json?
  createdAt    DateTime     @default(now())

  @@index([restaurantId, createdAt])
  @@index([createdAt])
  @@map("activities")
}

model Floor {
  id           String     @id @default(cuid(2))
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  position     Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  areas        Area[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("floors")
}

model Area {
  id        String   @id @default(cuid(2))
  floorId   String
  floor     Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tables    Table[]

  @@unique([floorId, name])
  @@index([floorId])
  @@map("areas")
}

model Table {
  id        String     @id @default(cuid(2))
  areaId    String
  area      Area       @relation(fields: [areaId], references: [id], onDelete: Cascade)
  label     String
  capacity  Int?
  shape     TableShape @default(SQUARE)
  positionX Float?
  positionY Float?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([areaId])
  @@map("tables")
}

// ── Menu domain (feature 003) ──────────────────────────────────────────────

model Category {
  id           String     @id @default(cuid(2))
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  position     Int        @default(0)
  isHidden     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  items        MenuItem[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("categories")
}

model MenuItem {
  id                  String               @id @default(cuid(2))
  restaurantId        String
  restaurant          Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId          String
  category            Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name                String
  description         String?
  priceMinor          Int
  inStock             Boolean              @default(true)
  calories            Int?
  servingAmount       Decimal?
  servingUnit         ServingUnit?
  unitPriceBasis      UnitPriceBasis       @default(AUTO)
  position            Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  optionGroups        OptionGroup[]
  media               MediaAsset[]
  availabilityWindows AvailabilityWindow[]
  allergens           Allergen[]
  tags                Tag[]

  @@index([restaurantId])
  @@index([categoryId])
  @@map("menu_items")
}

model Allergen {
  id           String     @id @default(cuid(2))
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  label        String
  isStandard   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  items        MenuItem[]

  @@unique([restaurantId, label])
  @@index([restaurantId])
  @@map("allergens")
}

model Tag {
  id           String     @id @default(cuid(2))
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  label        String
  color        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  items        MenuItem[]

  @@unique([restaurantId, label])
  @@index([restaurantId])
  @@map("tags")
}

model OptionGroup {
  id        String   @id @default(cuid(2))
  itemId    String
  item      MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name      String
  minSelect Int      @default(0)
  maxSelect Int?
  required  Boolean  @default(false)
  position  Int      @default(0)
  options   Option[]

  @@index([itemId])
  @@map("option_groups")
}

model Option {
  id              String      @id @default(cuid(2))
  groupId         String
  group           OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name            String
  priceDeltaMinor Int         @default(0)
  defaultSelected Boolean     @default(false)
  isAvailable     Boolean     @default(true)
  position        Int         @default(0)

  @@index([groupId])
  @@map("options")
}

model AvailabilityWindow {
  id       String      @id @default(cuid(2))
  itemId   String
  item     MenuItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  days     DayOfWeek[]
  startMin Int
  endMin   Int

  @@index([itemId])
  @@map("availability_windows")
}

model MediaAsset {
  id         String    @id @default(cuid(2))
  itemId     String
  item       MenuItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type       MediaType
  storageKey String
  mimeType   String
  sizeBytes  Int
  position   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([itemId])
  @@map("media_assets")
}

model Admin_user {
  id             String          @id
  name           String
  email          String
  emailVerified  Boolean         @default(false)
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  admin_sessions Admin_session[]
  admin_accounts Admin_account[]

  @@unique([email])
  @@map("admin_user")
}

model Admin_session {
  id         String     @id
  expiresAt  DateTime
  token      String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  ipAddress  String?
  userAgent  String?
  userId     String
  admin_user Admin_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("admin_session")
}

model Admin_account {
  id                    String     @id
  accountId             String
  providerId            String
  userId                String
  admin_user            Admin_user @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([userId])
  @@map("admin_account")
}

model Admin_verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("admin_verification")
}

model Admin_rate_limit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("admin_rate_limit")
}

model Dash_user {
  id            String         @id
  name          String
  email         String
  emailVerified Boolean        @default(false)
  image         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  dash_sessions Dash_session[]
  dash_accounts Dash_account[]

  dash_passkeys Dash_passkey[]

  @@unique([email])
  @@map("dash_user")
}

model Dash_session {
  id        String    @id
  expiresAt DateTime
  token     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  dash_user Dash_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("dash_session")
}

model Dash_account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  dash_user             Dash_user @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("dash_account")
}

model Dash_verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("dash_verification")
}

model Dash_rate_limit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("dash_rate_limit")
}

model Cust_user {
  id            String         @id
  name          String
  email         String
  emailVerified Boolean        @default(false)
  image         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  cust_sessions Cust_session[]
  cust_accounts Cust_account[]

  cust_passkeys Cust_passkey[]

  @@unique([email])
  @@map("cust_user")
}

model Cust_session {
  id        String    @id
  expiresAt DateTime
  token     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  cust_user Cust_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("cust_session")
}

model Cust_account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  cust_user             Cust_user @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("cust_account")
}

model Cust_verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("cust_verification")
}

model Cust_rate_limit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("cust_rate_limit")
}

model Dash_passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  dash_user    Dash_user @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("dash_passkey")
}

model Cust_passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  cust_user    Cust_user @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("cust_passkey")
}
