generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RestaurantStatus {
  ACTIVE
  INACTIVE
}

enum OnboardingStatus {
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum TableShape {
  SQUARE
  RECT
  ROUND
}

model Restaurant {
  id               String           @id @default(cuid(2))
  name             String
  slug             String           @unique
  status           RestaurantStatus @default(INACTIVE)
  onboardingStatus OnboardingStatus @default(IN_PROGRESS)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  floors           Floor[]

  @@map("restaurants")
}

model Floor {
  id           String     @id @default(cuid(2))
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  position     Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  areas        Area[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("floors")
}

model Area {
  id        String   @id @default(cuid(2))
  floorId   String
  floor     Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tables    Table[]

  @@unique([floorId, name])
  @@index([floorId])
  @@map("areas")
}

model Table {
  id        String   @id @default(cuid(2))
  areaId    String
  area      Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  label     String
  capacity  Int?
  shape     TableShape @default(SQUARE)
  positionX Float?
  positionY Float?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([areaId])
  @@map("tables")
}
