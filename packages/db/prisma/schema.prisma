generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RestaurantStatus {
  ACTIVE
  INACTIVE
}

enum OnboardingStatus {
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

// Billing tier. Managed by admin; no payment/invoicing wired yet — the field
// just records which plan a restaurant is on.
enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum TableShape {
  SQUARE
  RECT
  ROUND
}

enum ServingUnit {
  GRAM
  KILOGRAM
  MILLILITER
  LITER
  PIECE // adet
  PORTION // porsiyon (no unit price)
}

// How an item's normalized unit price is shown. AUTO lets @repo/core pick
// visibility + magnitude (per-100g for pricey weights, per-L for sensible
// volumes, hidden for tiny servings); HIDE suppresses it; the rest force a
// specific magnitude. See packages/core/src/unit-price.ts.
enum UnitPriceBasis {
  AUTO
  HIDE
  PER_KG
  PER_100G
  PER_L
  PER_100ML
  PER_PIECE
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum MediaType {
  PHOTO
  VIDEO
}

model Restaurant {
  id               String           @id @default(cuid(2))
  name             String
  slug             String           @unique
  status           RestaurantStatus @default(INACTIVE)
  onboardingStatus OnboardingStatus @default(IN_PROGRESS)
  // Locale preferences. Stored as strings (allowed set lives in @repo/schemas)
  // so adding a language/currency later needs no migration. Only "tr"/"TRY" are
  // offered today; downstream formatting still assumes TRY.
  language         String           @default("tr")
  currency         String           @default("TRY")
  plan             Plan             @default(FREE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  floors           Floor[]
  categories       Category[]
  menuItems        MenuItem[]
  allergens        Allergen[]
  tags             Tag[]

  @@map("restaurants")
}

model Floor {
  id           String     @id @default(cuid(2))
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  position     Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  areas        Area[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("floors")
}

model Area {
  id        String   @id @default(cuid(2))
  floorId   String
  floor     Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tables    Table[]

  @@unique([floorId, name])
  @@index([floorId])
  @@map("areas")
}

model Table {
  id        String     @id @default(cuid(2))
  areaId    String
  area      Area       @relation(fields: [areaId], references: [id], onDelete: Cascade)
  label     String
  capacity  Int?
  shape     TableShape @default(SQUARE)
  positionX Float?
  positionY Float?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([areaId])
  @@map("tables")
}

// ── Menu domain (feature 003) ──────────────────────────────────────────────

model Category {
  id           String     @id @default(cuid(2))
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  position     Int        @default(0)
  isHidden     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  items        MenuItem[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("categories")
}

model MenuItem {
  id                  String               @id @default(cuid(2))
  restaurantId        String
  restaurant          Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId          String
  category            Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name                String
  description         String?
  priceMinor          Int
  inStock             Boolean              @default(true)
  calories            Int?
  servingAmount       Decimal?
  servingUnit         ServingUnit?
  unitPriceBasis      UnitPriceBasis       @default(AUTO)
  position            Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  optionGroups        OptionGroup[]
  media               MediaAsset[]
  availabilityWindows AvailabilityWindow[]
  allergens           Allergen[]
  tags                Tag[]

  @@index([restaurantId])
  @@index([categoryId])
  @@map("menu_items")
}

model Allergen {
  id           String     @id @default(cuid(2))
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  label        String
  isStandard   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  items        MenuItem[]

  @@unique([restaurantId, label])
  @@index([restaurantId])
  @@map("allergens")
}

model Tag {
  id           String     @id @default(cuid(2))
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  label        String
  color        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  items        MenuItem[]

  @@unique([restaurantId, label])
  @@index([restaurantId])
  @@map("tags")
}

model OptionGroup {
  id        String   @id @default(cuid(2))
  itemId    String
  item      MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name      String
  minSelect Int      @default(0)
  maxSelect Int?
  required  Boolean  @default(false)
  position  Int      @default(0)
  options   Option[]

  @@index([itemId])
  @@map("option_groups")
}

model Option {
  id              String      @id @default(cuid(2))
  groupId         String
  group           OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name            String
  priceDeltaMinor Int         @default(0)
  defaultSelected Boolean     @default(false)
  isAvailable     Boolean     @default(true)
  position        Int         @default(0)

  @@index([groupId])
  @@map("options")
}

model AvailabilityWindow {
  id       String      @id @default(cuid(2))
  itemId   String
  item     MenuItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  days     DayOfWeek[]
  startMin Int
  endMin   Int

  @@index([itemId])
  @@map("availability_windows")
}

model MediaAsset {
  id         String    @id @default(cuid(2))
  itemId     String
  item       MenuItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type       MediaType
  storageKey String
  mimeType   String
  sizeBytes  Int
  position   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([itemId])
  @@map("media_assets")
}
