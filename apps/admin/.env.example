NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001
# Server-side (SSR/prefetch) base URL — defaults to NEXT_PUBLIC_API_URL.
# Set this when the public host isn't routable from the Next server itself
# (e.g. a LAN IP under WSL): point it at the API over localhost.
# API_INTERNAL_URL=http://localhost:3000/api
