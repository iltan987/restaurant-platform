# Public API base — absolute, with the /api prefix. Shares the apps' parent
# domain (api.<root>) so the session cookie is first-party under <root>.
#   Dev: http://localhost:3000/api  ·  Prod: https://api.ica2.xyz/api
NEXT_PUBLIC_API_URL=http://localhost:3000/api
# Optional: API base for SSR fetches when the public host isn't routable from
# the server (WSL/containers, LAN). Falls back to NEXT_PUBLIC_API_URL.
# API_INTERNAL_URL=http://localhost:3000/api
# Tenant workspace parent domain (`<slug>.<root>`). Prod: panel.ica2.xyz
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3001
# Customer storefront parent domain, for table-QR menu URLs. Prod: ica2.xyz
NEXT_PUBLIC_CUSTOMER_ROOT_DOMAIN=localhost:3002
# Media host for next/image's remotePatterns — match the API's value (MinIO dev,
# R2 prod). Build-time only; components get media URLs from API responses.
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/menu-media
# Google sign-in on /giris ("Google ile devam et" button → OAuth). Enable only
# after the API has GOOGLE_CLIENT_ID/SECRET; sign-up stays invitation-only
# (links to an already-invited account only).
# NEXT_PUBLIC_GOOGLE_ENABLED=true
# LAN device testing (e.g. a phone): `pnpm host lan` points every app at your
# LAN IP via <ip>.nip.io — not a bare IP, the cookie needs a domain match;
# `pnpm host local` reverts. First time, also add HOSTNAME=0.0.0.0 and
# ALLOWED_DEV_ORIGIN=<ip>.nip.io.
