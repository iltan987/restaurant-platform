# Dev: absolute, direct to the API (same-site localhost, so cookies work).
# Prod: set to "/api" (relative) and add API_ORIGIN below — each app then proxies
# /api to the API on its OWN origin so the session cookie is first-party.
NEXT_PUBLIC_API_URL=http://localhost:3000/api
# Prod only — the API's external origin (no /api). Enables the next.config proxy
# of /api/* → this origin, keeping auth cookies first-party (works in Safari).
# API_ORIGIN=https://your-api.onrender.com
# Prod only — absolute API base for server-side (SSR) fetches, which hit the API
# directly rather than via the proxy. Usually <API_ORIGIN>/api.
# API_INTERNAL_URL=https://your-api.onrender.com/api
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3001
NEXT_PUBLIC_CUSTOMER_ROOT_DOMAIN=localhost:3002
# Tenancy mode. "subdomain" (default): tenants at <slug>.<root> (prod/local).
# "path": tenants at <host>/s/<slug> on a single host — for free staging (e.g.
# Vercel) where wildcard subdomains aren't available. No-op unless set to "path".
# NEXT_PUBLIC_TENANT_MODE=path
# --- Optional: test on a real device over your LAN (e.g. a phone) ---
# Point the NEXT_PUBLIC_* vars above at your machine's LAN host, then expose the
# dev server and let SSR reach the API over localhost (the LAN IP isn't routable
# from the server):
#   HOSTNAME=0.0.0.0
#   ALLOWED_DEV_ORIGIN=192.168.x.x.nip.io
#   API_INTERNAL_URL=http://localhost:3000/api
#
# IMPORTANT (auth): use <ip>.nip.io — NOT the bare IP — for NEXT_PUBLIC_API_URL,
# on the SAME parent domain as the app and the API's ROOT_DOMAIN. The session
# cookie is set with Domain=ROOT_DOMAIN; a browser only accepts a cookie whose
# domain matches the responding host, so a bare-IP API host silently drops it
# and sign-in appears to do nothing:
#   NEXT_PUBLIC_API_URL=http://192.168.x.x.nip.io:3000/api
