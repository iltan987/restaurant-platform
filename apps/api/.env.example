PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/restaurant
ADMIN_URL=http://localhost:3003
DASHBOARD_URL=http://localhost:3001
CUSTOMER_URL=http://localhost:3002

# Object storage for menu media (S3-compatible: MinIO in dev, Cloudflare R2 in prod).
# Dev values target the MinIO service in docker-compose.yml (bucket auto-created on `up`).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=menu-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Public base URL objects are served from (MinIO bucket in dev; R2 public/custom domain in prod).
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/menu-media

# --- Authentication (Better Auth) ---
# Secret for signing sessions/tokens. Generate one: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Externally-reachable base URL of THIS api (no /api suffix). Better Auth builds
# OAuth callback URLs and validates request origins against it. For LAN device
# testing, use your machine's nip.io host (e.g. http://192.168.x.x.nip.io:3000).
BETTER_AUTH_URL=http://localhost:3000
# Single platform-admin bootstrap credentials. Seeded idempotently via
# `pnpm --filter api seed:admin`; sign-up is otherwise disabled for the admin app.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=
# Google OAuth for the customer storefront AND the dashboard (one OAuth client,
# shared). Authorized redirect URIs (add both in Google Cloud):
#   <BETTER_AUTH_URL>/api/auth/customer/callback/google
#   <BETTER_AUTH_URL>/api/auth/dashboard/callback/google
# For dashboard One Tap, also add the dashboard apex to "Authorized JavaScript
# origins" (e.g. https://panel.ica2.xyz, http://localhost:3001).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Prod-only: registrable root domain (e.g. ica2.xyz). Enables cross-subdomain
# cookies (api.<root> ↔ <slug>.<root>) and the `https://*.<ROOT_DOMAIN>` tenant
# wildcard in trustedOrigins. This single var is what makes the session cookie
# first-party across every app subdomain. Leave unset in local dev (same-site
# localhost); for LAN/nip.io device testing set it to e.g. 192.168.x.x.nip.io.
ROOT_DOMAIN=

# --- Email transport (owner/member invitations, magic links, OTP codes) ---
# `console` logs recipient + link + code to stdout (dev default, zero setup).
# `resend` sends via the Resend HTTP API (https/443) — REQUIRED on PaaS hosts
#   that block outbound SMTP ports (Render blocks 25/465/587, so SMTP just hangs).
#   Set RESEND_API_KEY + EMAIL_FROM=no-reply@<verified-root>; verify ROOT_DOMAIN
#   in Resend (it adds DKIM/SPF DNS records). This is the prod default.
# `smtp` sends via Nodemailer — only on hosts that allow SMTP egress.
#   Dev: the Mailpit sink in docker-compose — SMTP_HOST=localhost, SMTP_PORT=1025,
#   no user/pass; inbox at :8025. (Gmail SMTP fails on Render: IPv6-only + blocked port.)
EMAIL_TRANSPORT=console
# Required when EMAIL_TRANSPORT=resend (the API key from resend.com, re_...):
RESEND_API_KEY=
# Required when EMAIL_TRANSPORT=smtp:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@example.com
