PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/restaurant
ADMIN_URL=http://localhost:3003
DASHBOARD_URL=http://localhost:3001
CUSTOMER_URL=http://localhost:3002
# Log verbosity (pino): trace|debug|info|warn|error. Pretty in dev, JSON in prod.
LOG_LEVEL=info

# Object storage for menu media (S3-compatible: MinIO in dev, Cloudflare R2 in
# prod). Dev values target the MinIO service in docker-compose.yml.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=menu-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Public base URL objects are served from (MinIO in dev; R2 domain in prod).
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/menu-media

# --- Authentication (Better Auth) ---
# Secret for signing sessions/tokens. Generate: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Externally-reachable base URL of THIS api (no /api suffix); used for OAuth
# callbacks + origin checks. LAN testing: `pnpm host lan` sets this everywhere.
BETTER_AUTH_URL=http://localhost:3000
# Platform-admin bootstrap creds. Seeded via `pnpm --filter api seed:admin`.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=
# Google OAuth (one client, shared by customer + dashboard). Add both redirect
# URIs in Google Cloud: <BETTER_AUTH_URL>/api/auth/{customer,dashboard}/callback/google
# The dashboard GSI button also needs the apex under "Authorized JS origins".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Prod-only: registrable root domain (e.g. ica2.xyz). Enables cross-subdomain
# cookies + the `https://*.<ROOT_DOMAIN>` tenant wildcard. Unset in local dev;
# for LAN testing `pnpm host lan` sets it (e.g. 192.168.x.x.nip.io).
ROOT_DOMAIN=

# --- Email transport (invitations, magic links, OTP codes) ---
# console: logs recipient + link + code to stdout (dev default, zero setup).
# resend:  Resend HTTP API (https) — REQUIRED on hosts blocking SMTP (e.g.
#   Render). Set RESEND_API_KEY + EMAIL_FROM=no-reply@<verified-root>.
# smtp:    Nodemailer — only where SMTP egress is allowed. Dev: Mailpit sink
#   (SMTP_HOST=localhost, SMTP_PORT=1025, no auth; inbox at :8025).
EMAIL_TRANSPORT=console
# Required when EMAIL_TRANSPORT=resend (re_... key from resend.com):
RESEND_API_KEY=
# Required when EMAIL_TRANSPORT=smtp:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@example.com
