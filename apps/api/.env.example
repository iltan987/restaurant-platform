PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://user:pass@localhost:5432/restaurant
ADMIN_URL=http://localhost:3003
DASHBOARD_URL=http://localhost:3001

# Object storage for menu media (S3-compatible: MinIO in dev, Cloudflare R2 in prod).
# Dev values target the MinIO service in docker-compose.yml (bucket auto-created on `up`).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=menu-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Public base URL objects are served from (MinIO bucket in dev; R2 public/custom domain in prod).
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/menu-media
