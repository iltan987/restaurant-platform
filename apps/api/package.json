{
  "name": "api",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "seed:admin": "nest build && node dist/auth/seed-admin",
    "lint": "eslint",
    "format": "prettier --write \"**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@better-auth/passkey": "catalog:",
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-express": "^11.1.27",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.9",
    "@repo/core": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/schemas": "workspace:*",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "express": "^5.2.1",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "catalog:",
    "pino": "^10.3.1",
    "react": "catalog:",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.27",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "catalog:",
    "@types/react": "catalog:",
    "@types/supertest": "^7.2.0",
    "eslint": "catalog:",
    "jest": "^30.4.2",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "typescript": "catalog:"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts",
      "tsx"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleNameMapper": {
      "^better-auth(/.*)?$": "<rootDir>/../test/better-auth.mock.ts",
      "^@better-auth/passkey$": "<rootDir>/../test/better-auth.mock.ts",
      "^@react-email/(components|render)$": "<rootDir>/../test/react-email.mock.ts"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.spec.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
