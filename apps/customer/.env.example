NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3002
# Tenancy mode. "subdomain" (default): tenants at <slug>.<root> (prod/local).
# "path": tenants at <host>/s/<slug> on a single host — for free staging (e.g.
# Vercel) where wildcard subdomains aren't available. No-op unless set to "path".
# NEXT_PUBLIC_TENANT_MODE=path
# --- Optional: test on a real device over your LAN (e.g. a phone) ---
# Point the NEXT_PUBLIC_* vars above at your machine's LAN host (an IP, or
# <ip>.nip.io so tenant subdomains resolve), then expose the dev server and let
# SSR reach the API over localhost (the LAN IP isn't routable from the server):
#   HOSTNAME=0.0.0.0
#   ALLOWED_DEV_ORIGIN=192.168.x.x.nip.io
#   API_INTERNAL_URL=http://localhost:3000/api
